# FraudGraph AI Enterprise Environment Configuration Template
# Copy this file to .env for local configuration

VITE_APP_TITLE="FraudGraph AI — Enterprise Financial Crime Intelligence"
VITE_APP_VERSION="1.0.0"
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_WS_URL="ws://localhost:8000/ws"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="CHANGE_ME_IN_SECURE_VAULT"
NEO4J_DATABASE="fraudgraph"

# PostgreSQL Canonical Event & Audit Store
DATABASE_URL="postgresql://frauduser:CHANGE_ME@localhost:5432/fraudgraph_db"

# Redis Cache & Celery Broker
REDIS_URL="redis://localhost:6379/0"

# LLM Orchestration Keys (Do NOT commit real keys to version control!)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Security & Encryption
JWT_SECRET_KEY="CHANGE_ME_TO_A_SECURE_RANDOM_64_CHAR_SECRET"
HASH_CHAIN_SALT="CHANGE_ME_HASH_CHAIN_INTEGRITY_SALT"
